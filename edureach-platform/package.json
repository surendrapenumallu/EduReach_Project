{
  "name": "edureach-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EduReach College Intelligence Platform Monorepo",
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test": "npm --prefix server test && npm --prefix client test",
    "start:server": "npm --prefix server run start",
    "start": "npm --prefix server run start"
  }
}
